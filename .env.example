# GoHighLevel API Configuration
# Copy this file to .env for local testing (DO NOT commit .env file)
# For Netlify deployment, set these in the Netlify dashboard under Site settings > Environment variables

# Your GoHighLevel API Key (Private/Agency API Key)
# Get this from: GHL Settings > API > Private API Key
GHL_API_KEY=pit-your-api-key-here

# Your GoHighLevel Location ID
# Get this from: GHL Settings > Business Profile > Location ID
GHL_LOCATION_ID=your-location-id-here

# GHL API Version (usually doesn't need to change)
GHL_API_VERSION=2021-07-28
